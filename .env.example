# =============================================================================
# RedCarpetHQ — deployment environment (Robinhood Chain Testnet)
# Copy to .env and fill in values. NEVER commit a real .env.
# =============================================================================

# --- Required ---------------------------------------------------------------

# Private key of the deployer wallet (becomes protocol owner)
DEPLOYER_PRIVATE_KEY=

# Must equal the deployer address.
# Check with: cast wallet address --private-key $DEPLOYER_PRIVATE_KEY
OWNER_ADDRESS=

# Address that receives protocol fees
FEE_SAFE_ADDRESS=

# --- Payment token ----------------------------------------------------------

# Keep false for Robinhood testnet — the script deploys TestUSDR as the
# payment token. (true = use real USDC, not applicable on testnet)
PRODUCTION=false

# Unused when PRODUCTION=false, but must be a valid address — the verification
# script parses it unconditionally.
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: set to reuse an existing TestUSDR instead of deploying a fresh one.
# Deploy one with: forge script script/DeployTestUSDR.s.sol --rpc-url robinhoodtestnet --broadcast
# TEST_USDR_ADDRESS=

# --- Optional ---------------------------------------------------------------

# Comma-separated addresses; each is set as a CampaignAdmin screener
# ADMIN_ADDRESSES=0xabc...,0xdef...

# --- RPC --------------------------------------------------------------------

ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# =============================================================================
# Post-deployment — paste from the script's "=== Add to .env ===" output block.
# Required by script/VerifyMultisigSetup.s.sol (see README "After deployment").
# =============================================================================

TEST_USDR_ADDRESS=
REGISTRY_ADDRESS=
CAMPAIGN_ADDRESS=
MULTI_ROUND_CAMPAIGN_ADDRESS=
CAMPAIGN_ADMIN_ADDRESS=
CAMPAIGN_FEE_MANAGER_ADDRESS=
MARKET_ADDRESS=
TOKEN_IMPLEMENTATION_ADDRESS=
DIVIDEND_DISTRIBUTOR_ADDRESS=
HYBRID_ORACLE_ADDRESS=
OPTIMISTIC_ORACLE_ADDRESS=
RISK_ORACLE_ADDRESS=
RATE_MODEL_ADDRESS=
VOLUME_TRACKER_ADDRESS=
TIER_LOGIC_ADDRESS=
INTEREST_LOGIC_ADDRESS=
LENDING_LOGIC_ADDRESS=
STABILITY_LOGIC_ADDRESS=
MULTI_ROUND_LOGIC_ADDRESS=
VAULT_FACTORY_ADDRESS=
LENDING_MANAGER_ADDRESS=
FEE_DISTRIBUTOR_ADDRESS=
CONTEST_ADDRESS=
KEEPER_REGISTRY_ADDRESS=
BURN_REDEMPTION_ADDRESS=
SURVEY_SNAPSHOT_ADDRESS=
